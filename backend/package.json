{
  "name": "lablink-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5",
    "bcryptjs": "^2",
    "cors": "^2",
    "dotenv": "^16",
    "express": "^4",
    "jsonwebtoken": "^9",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/cors": "^2",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6",
    "jest": "^29",
    "prisma": "^5",
    "supertest": "^7",
    "ts-jest": "^29",
    "ts-node-dev": "^2",
    "typescript": "^5"
  }
}
